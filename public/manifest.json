{
  "manifest_version": 3,
  "name": "Kode Glass",
  "short_name": "Kode Glass",
  "description": "Visual accessibility diagnostics for QA teams.",
  "version": "2.0.1",
  "icons": {
    "16": "icons/logo-128.png",
    "32": "icons/logo-128.png",
    "48": "icons/logo-128.png",
    "128": "icons/logo-128.png"
  },
  "action": {
    "default_title": "Kode Glass",
    "default_icon": {
      "16": "icons/logo-128.png",
      "32": "icons/logo-128.png",
      "48": "icons/logo-128.png",
      "128": "icons/logo-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "downloads", "identity", "sidePanel", "scripting", "storage", "tabCapture", "tabs", "tts"],
  "host_permissions": ["https://api.atlassian.com/*", "https://auth.atlassian.com/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' blob: data:; connect-src https://api.atlassian.com https://auth.atlassian.com"
  }
}
